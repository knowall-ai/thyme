# Microsoft Entra ID (Azure AD) Configuration
NEXT_PUBLIC_AZURE_CLIENT_ID=your-entra-app-client-id
AZURE_CLIENT_SECRET=your-entra-app-secret
# Tenant ID is used for both authentication and BC API URL construction
NEXT_PUBLIC_AZURE_TENANT_ID=your-tenant-id
NEXT_PUBLIC_AZURE_REDIRECT_URI=http://localhost:3000

# Business Central Configuration
NEXT_PUBLIC_BC_ENVIRONMENT=sandbox
NEXT_PUBLIC_BC_COMPANY_ID=your-business-central-company-guid
# Base URL without tenant - tenant ID from NEXT_PUBLIC_AZURE_TENANT_ID is added automatically
NEXT_PUBLIC_BC_BASE_URL=https://api.businesscentral.dynamics.com/v2.0

# Approved organisations: comma-separated Microsoft Entra tenant IDs (GUIDs) allowed to
# use Timmie, besides KnowAll's own tenant. Read by the server at runtime (App Service
# setting), so approving an organisation needs no rebuild. Everyone else sees
# "Your organisation isn't set up on Timmie yet". See docs/DEPLOYMENT.adoc.
APPROVED_TENANT_IDS=

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI usage resources (comma-separated BC resource numbers, default AI-USAGE): their job ledger
# entries are shown as AI cost and never count as hours. Machine resources always count as AI.
# Read by the server at runtime (/api/config), so changing it (e.g. an App Service application
# setting) takes effect on the next page load, with no rebuild.
THYME_AI_RESOURCES=AI-USAGE
